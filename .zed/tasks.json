[
  {
    "label": "Proposta",
    "command": "uv run python -m automation proposta",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Assinatura",
    "command": "uv run python -m automation assinatura",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Completo",
    "command": "uv run python -m automation completo",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Finalizar",
    "command": "uv run python -m automation finalizar",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Pytest",
    "command": "uv run python -m pytest tests/ -v",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Pytest (Quiet)",
    "command": "uv run python -m pytest tests/",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Teste: Logo e Footer",
    "command": "uv run python -m pytest tests/test_logo_footer_contrato.py -v",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Teste Visual: Gerar PDFs",
    "command": "$env:PYTHONIOENCODING='utf-8'; uv run python -m tests.gerar_pdfs_teste",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Teste Visual: Gerar PDFs (30 dias)",
    "command": "$env:PYTHONIOENCODING='utf-8'; uv run python -m tests.gerar_pdfs_teste_30",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Ruff Check",
    "command": "uv run ruff check .",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Ruff Format",
    "command": "uv run ruff format --check .",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Mypy",
    "command": "uv run mypy automation/",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Sync Dev",
    "command": "uv sync --all-extras --dev",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
